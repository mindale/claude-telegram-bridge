# Скопируйте этот файл в .env и заполните.
# cp .env.example .env

# Токен вашего Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш числовой Telegram user id (узнать у @userinfobot).
# Можно несколько через запятую: 111111,222222
ALLOWED_USER_IDS=111111111

# Путь к бинарнику claude (обычно просто "claude", если он в PATH)
CLAUDE_BIN=claude

# Куда складывать рабочие директории сессий/файлов по чатам
SESSIONS_DIR=./sessions

# Таймаут ожидания ответа Claude Code, секунды
CLAUDE_TIMEOUT_SECONDS=300

# Дополнительные флаги для claude (через пробел). ВНИМАТЕЛЬНО прочитайте
# README про --dangerously-skip-permissions, прежде чем включать.
CLAUDE_EXTRA_ARGS=

# Модель Whisper для распознавания голосовых: tiny/base/small/medium/large-v3
# small — хороший баланс скорости/качества для CPU
WHISPER_MODEL_SIZE=small
WHISPER_LANGUAGE=ru

